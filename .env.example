# Bind to localhost by default. For LAN access, use the host LAN IP or 0.0.0.0 for all IPv4 interfaces.
# Use an HTTPS reverse proxy before enabling OIDC.
TRACKER_BIND_IP=127.0.0.1
TRACKER_IMAGE=ghcr.io/lachateau-holdings-llc/vulntracker:v0.1.0
TRACKER_AUTH_MODE=off

# Entra ID: enter a tenant GUID and leave OIDC_ISSUER_URL blank.
# Other OIDC providers: enter the exact discovery issuer and leave the tenant blank.
OIDC_ENTRA_TENANT_ID=
OIDC_ISSUER_URL=
OIDC_PROVIDER_NAME=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid profile email"
# Defaults to roles for Entra and groups for other providers.
OIDC_ACCESS_CLAIM=
OIDC_ALLOWED_VALUE=
OIDC_ADMIN_VALUE=
# Leave blank for discovery, or set client_secret_basic or client_secret_post.
OIDC_TOKEN_AUTH_METHOD=
